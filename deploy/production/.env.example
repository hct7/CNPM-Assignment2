# Copy this file to /opt/brewlite/.env on the VPS. Fill values there; never commit the real file.
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://brewlite:URL_ENCODED_PASSWORD@db:5432/brewlite
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_DOMAIN=shop.example.com
API_DOMAIN=api.example.com
IMAGE_PREFIX=ghcr.io/OWNER/REPOSITORY
PAYMENT_MOCK_MODE=success
