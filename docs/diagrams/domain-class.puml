@startuml
title BrewLite - domain class model
class User {+id: UUID;+name: string;+email: string;+passwordHash: string;+role: UserRole}
class Product {+id: UUID;+name: string;+description: string;+basePrice: int;+stock: int;+active: bool}
class Order {+id: UUID;+status: OrderStatus;+total: int;+idempotencyKey: string;+createdAt: datetime}
class OrderItem {+id: UUID;+quantity: int;+unitPrice: int;+size: string;+toppings: json;+lineTotal: int}
class Payment {+id: UUID;+method: PaymentMethod;+status: PaymentStatus;+amount: int;+providerRef: string;+idempotencyKey: string}
class Promotion {+id: UUID;+code: string;+discountType: DiscountType;+value: int;+active: bool}
class LoyaltyTransaction {+id: UUID;+pointsDelta: int;+reason: string;+createdAt: datetime}
enum UserRole { CUSTOMER; STAFF; MANAGER }
enum OrderStatus { PENDING_PAYMENT; CONFIRMED; PREPARING; READY; COMPLETED; PAYMENT_FAILED; CANCELLED }
enum PaymentStatus { PENDING; SUCCESS; FAILED; REFUNDED }
enum PaymentMethod { WALLET; CARD }
enum DiscountType { PERCENT; FIXED }
User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem
Product "1" -- "0..*" OrderItem : snapshot source
Order "1" -- "0..*" Payment
Order "0..*" -- "0..*" Promotion : applies
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction : earns
@enduml
